# FastAPI / Database configuration
DATABASE_URL=sqlite:///./data/kiapat.db
SECRET_KEY=change-me
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Enable shared API key auth (used by mobile emulator)
# Set to any strong random string; provide the same value in the X-API-Key header from clients
API_SHARED_SECRET=

# CORS
CORS_ALLOWED_ORIGINS=*
